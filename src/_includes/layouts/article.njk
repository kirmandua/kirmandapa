---
layout: layouts/base.njk
---

<article class="article-page">
  <div class="article-hero grid-texture">
    <div class="container article-hero-inner">
      <a href="/berita" class="back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Kembali ke Berita
      </a>

      <div class="article-header">
        {% if tags %}
        <div class="article-tags">
          {% for tag in tags %}
            {% if tag != "berita" %}
            <span class="badge badge-teal">{{ tag }}</span>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}

        <h1 class="article-title">{{ title }}</h1>

        {% if excerpt %}
        <p class="article-excerpt">{{ excerpt }}</p>
        {% endif %}

        <div class="article-meta">
          <div class="meta-item">
            <span class="meta-icon">{% set icon = "user" %}{% include "partials/icon.njk" %}</span>
            <span class="meta-text">{{ author if author else "Tim Redaksi KIR" }}</span>
          </div>
          <span class="meta-dot">•</span>
          <div class="meta-item">
            <span class="meta-icon">{% set icon = "clock" %}{% include "partials/icon.njk" %}</span>
            <time datetime="{{ date }}">{{ date | readableDate }}</time>
          </div>
          <span class="meta-dot">•</span>
          <div class="meta-item">
            <span class="meta-icon">{% set icon = "flask" %}{% include "partials/icon.njk" %}</span>
            <span>Jurnal KIR</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container article-content-wrapper">
    <div class="article-body">
      {{ content | safe }}
    </div>

    <div class="article-footer">
      <div class="article-author-card">
        <div class="author-avatar">{% set icon = "flask" %}{% include "partials/icon.njk" %}</div>
        <div class="author-info">
          <h4>{{ author if author else "Tim Redaksi KIR MAN 2 Kota Bogor" }}</h4>
          <p>Kelompok Ilmiah Remaja MAN 2 Kota Bogor — Wadah riset dan inovasi warga madrasah.</p>
        </div>
      </div>

      <div class="article-share">
        <span class="share-label">Bagikan Catatan Ini:</span>
        <div class="share-buttons">
          <button type="button" class="btn-share" onclick="navigator.clipboard.writeText(window.location.href); alert('Tautan artikel berhasil disalin!');">
            {% set icon = "copy" %}{% include "partials/icon.njk" %} Salin Link
          </button>
          <a href="https://api.whatsapp.com/send?text={{ title | urlencode }}%20{{ page.url | urlencode }}" target="_blank" rel="noopener" class="btn-share btn-wa">
            {% set icon = "whatsapp" %}{% include "partials/icon.njk" %} WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="article-navigation">
      <a href="/berita" class="btn btn-secondary">← Kembali ke Halaman Berita & Kegiatan</a>
    </div>
  </div>
</article>
