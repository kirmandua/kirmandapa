<div class="journal-item reveal" data-category="{{ entry.category }}">
  <span class="journal-num">{{ entry.num }}</span>
  <div>
    <h3>{{ entry.title }}</h3>
    <div class="journal-meta">{{ entry.authors }} — {{ entry.year }}</div>
    <p>{{ entry.abstract }}</p>
  </div>
  <a href="#" class="btn btn-sm btn-outline">Unduh Abstrak</a>
</div>
