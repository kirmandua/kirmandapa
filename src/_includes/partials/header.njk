<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-mark"><img src="/assets/logo.png" alt="Logo KIR MAN 2 Kota Bogor"></span>
      <span class="brand-text"><b>{{ site.name }}</b><span>{{ site.subtitle }}</span></span>
    </a>
    <nav class="notebook-nav" id="notebookNav">
      {% for item in nav %}
      <a href="{{ item.url }}" class="tab{% if page.url == item.url %} active{% endif %}{% if item.cta %} tab-cta{% endif %}">{{ item.label }}</a>
      {% endfor %}
    </nav>
    <button class="nav-toggle" id="navToggle" aria-label="Buka menu">☰</button>
  </div>
</header>
