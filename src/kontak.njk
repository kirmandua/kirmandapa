---
layout: layouts/base.njk
title: "Pendaftaran & Kontak"
description: "Daftar jadi anggota baru KIR MAN 2 Kota Bogor, baca FAQ, dan temukan kontak resmi madrasah."
crumb: "Pendaftaran & Kontak"
---

{% include "partials/hero.njk" %}

<!-- FORM PENDAFTARAN -->
<section class="section section-alt" id="daftar">
  <div class="container">
    <div class="hero-grid" style="align-items:flex-start;">
      <div class="reveal">
        <div class="specimen-label">Spesimen 17 — Formulir Pendaftaran</div>
        <h2 style="font-family:var(--font-display); font-weight:600; font-size:clamp(24px,3.2vw,32px); margin-bottom:14px;">Gabung jadi anggota baru</h2>
        <p style="color:var(--ink-soft); margin-bottom:24px;">Lengkapi data di samping. Formulir ini juga tersedia dalam versi Google Form yang bisa dibagikan lewat grup kelas.</p>

        <div class="form-card">
          <form id="registerForm">
            <div class="form-row">
              <div class="form-field">
                <label for="full_name">Nama Lengkap</label>
                <input type="text" id="full_name" name="full_name" placeholder="Nama sesuai KTP/KK" required>
              </div>
              <div class="form-field">
                <label for="school">Kelas</label>
                <input type="text" id="school" name="school" placeholder="Contoh: XI IPA 2" required>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="birth_date">Tanggal Lahir</label>
                <input type="date" id="birth_date" name="birth_date" required>
              </div>
              <div class="form-field">
                <label for="whatsapp">Nomor WhatsApp</label>
                <input type="tel" id="whatsapp" name="whatsapp" placeholder="08xx-xxxx-xxxx" required>
              </div>
            </div>
            <div class="form-field">
              <label>Mata Pelajaran Diminati</label>
              <div class="checkbox-grid">
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Matematika"> Matematika</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Fisika"> Fisika</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Kimia"> Kimia</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Biologi"> Biologi</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Geografi"> Geografi</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Ekonomi"> Ekonomi</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Sosiologi"> Sosiologi</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Sejarah"> Sejarah</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="PAI"> PAI</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Akidah Akhlak"> Akidah Akhlak</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Fikih"> Fikih</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="Al-Quran Hadis"> Al-Quran Hadis</label>
                <label class="checkbox-label"><input type="checkbox" name="subjects" value="SKI"> SKI</label>
              </div>
            </div>
            <div class="form-field">
              <label>Minat / Bidang</label>
              <div class="checkbox-grid">
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Olimpiade"> Olimpiade</label>
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Karya Tulis Ilmiah"> Karya Tulis Ilmiah</label>
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Programming"> Programming</label>
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Robotik"> Robotik</label>
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Multimedia"> Multimedia</label>
                <label class="checkbox-label"><input type="checkbox" name="interests" value="Seni"> Seni</label>
              </div>
            </div>
            <div class="form-field">
              <label for="motivation">Alasan Ingin Bergabung</label>
              <textarea id="motivation" name="motivation" rows="4" placeholder="Ceritakan singkat apa yang membuatmu tertarik pada KIR..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" id="registerSubmit">Kirim Pendaftaran →</button>
            <div class="form-success">✓ Pendaftaran terkirim! Tim KIR akan menghubungimu lewat WhatsApp/email.</div>
            <div class="form-error" role="alert"></div>
            <p class="form-note">Data terkirim langsung ke panitia KIR MAN 2 Kota Bogor.</p>
          </form>
        </div>
      </div>

      <!-- FAQ -->
      <div class="reveal">
        <div class="specimen-label amber">Spesimen 18 — Pertanyaan Umum</div>
        <h2 style="font-family:var(--font-display); font-weight:600; font-size:clamp(24px,3.2vw,32px); margin-bottom:20px;">FAQ</h2>
        <div>
          {% for item in faq %}
            {% include "partials/accordion-item.njk" %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- KONTAK & MEDSOS -->
<section class="section" id="kontak-kami">
  <div class="container">
    <div class="section-head reveal">
      <div class="specimen-label coral">Spesimen 19 — Kontak & Media Sosial</div>
      <h2>Hubungi kami</h2>
      <p>Pertanyaan lain di luar FAQ? Sapa kami lewat kanal berikut.</p>
    </div>

    <div class="contact-grid">
      {% for card in contact.cards %}
        {% include "partials/contact-card.njk" %}
      {% endfor %}
    </div>

    <div class="reveal" style="margin-bottom:32px;">
      <div class="social-links">
        {% for s in contact.social %}
        <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.label }}</a>
        {% endfor %}
      </div>
    </div>

    <div class="reveal">
      <div class="map-wrapper">
        <iframe
          class="osm-map"
          title="Peta Lokasi MAN 2 Kota Bogor - OpenStreetMap"
          src="https://www.openstreetmap.org/export/embed.html?bbox={{ contact.map.bbox }}&amp;layer=mapnik&amp;marker={{ contact.map.lat }}%2C{{ contact.map.lng }}"
          loading="lazy">
        </iframe>
        <div class="map-caption">
          <span>📍 MAN 2 Kota Bogor — Jl. Raya Pajajaran No. 6, Baranangsiang, Kota Bogor</span>
          <a href="https://www.openstreetmap.org/?mlat={{ contact.map.lat }}&amp;mlon={{ contact.map.lng }}#map={{ contact.map.zoom }}/{{ contact.map.lat }}/{{ contact.map.lng }}" target="_blank" rel="noopener" class="btn-map-link">
            Buka Peta Lebih Besar ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
